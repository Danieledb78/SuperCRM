# ============================================
# SuperCRM Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# ============================================
# Database
# ============================================
POSTGRES_USER=supercrm
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=supercrm
POSTGRES_PORT=5432

# Connection URL (for local development)
DATABASE_URL=postgresql://supercrm:your_secure_password_here@localhost:5432/supercrm

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ============================================
# API Configuration
# ============================================
NODE_ENV=development
API_PORT=3001
API_BASE_URL=http://localhost:3001

# JWT Secret (generate with: openssl rand -base64 64)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ============================================
# Frontend Configuration
# ============================================
WEB_PORT=3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================
# Email Integration - Microsoft Outlook
# Get credentials from Azure Portal > App Registrations
# ============================================
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/email/oauth/callback

# ============================================
# Email Integration - Google Gmail
# Get credentials from Google Cloud Console
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/email/oauth/callback

# ============================================
# AI Integration - OpenAI
# Get API key from https://platform.openai.com
# ============================================
OPENAI_API_KEY=

# ============================================
# AI Integration - Anthropic (Claude)
# Get API key from https://console.anthropic.com
# ============================================
ANTHROPIC_API_KEY=

# ============================================
# Storage (for file uploads)
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ============================================
# Email Sending (SMTP)
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=SuperCRM

# ============================================
# Italian Fiscal Integration
# ============================================
# Fatture in Cloud
FATTUREINCLOUD_API_KEY=
FATTUREINCLOUD_API_SECRET=

# ============================================
# Security
# ============================================
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
